#!/bin/sh
# ============================================================
#  pre-commit hook — Python code quality gate
#  Enforced rules: black formatting, isort, flake8 linting, pytest,
#                  feature count guard, secrets scan
#  Install: git config core.hooksPath .githooks
# ============================================================

echo "🔍 [pre-commit] Running Python code quality checks..."

# ── 1. Check black formatting ───────────────────────────────
echo "  → Checking black formatting..."
.venv/Scripts/python.exe -m black --check ai/ --line-length 120 --quiet 2>&1
BLACK_EXIT=$?
if [ $BLACK_EXIT -ne 0 ]; then
  echo ""
  echo "  ❌ BLACK FORMATTING FAILED"
  echo "  Run: .venv/Scripts/python.exe -m black ai/ --line-length 120"
  echo "  Then re-stage and commit."
  exit 1
fi
echo "  ✅ Black: OK"

# ── 2. Check flake8 linting ─────────────────────────────────
echo "  → Checking flake8 linting..."
.venv/Scripts/python.exe -m flake8 ai/ --max-line-length=120 --exclude=ai/stubs/,ai/tests/,.venv/ --ignore=E501,W503 2>&1
FLAKE_EXIT=$?
if [ $FLAKE_EXIT -ne 0 ]; then
  echo ""
  echo "  ❌ FLAKE8 LINTING FAILED"
  echo "  Fix the issues above, then re-stage and commit."
  exit 1
fi
echo "  ✅ Flake8: OK"

# ── 2b. Check isort import ordering ─────────────────────────
echo "  → Checking isort import ordering..."
.venv/Scripts/python.exe -m isort ai/ --check-only --quiet 2>&1
ISORT_EXIT=$?
if [ $ISORT_EXIT -ne 0 ]; then
  echo ""
  echo "  ❌ ISORT IMPORT ORDER FAILED"
  echo "  Run: .venv/Scripts/python.exe -m isort ai/"
  echo "  Then re-stage and commit."
  exit 1
fi
echo "  ✅ isort: OK"

# ── 3. Run pytest ────────────────────────────────────────────
echo "  → Running pytest ai/tests/..."
.venv/Scripts/python.exe -m pytest ai/tests/ -q --tb=short 2>&1
PYTEST_EXIT=$?
if [ $PYTEST_EXIT -ne 0 ]; then
  echo ""
  echo "  ❌ TESTS FAILED — Commit blocked until all tests pass."
  echo "  Run: .venv/Scripts/python.exe -m pytest ai/tests/ -v"
  exit 1
fi
echo "  ✅ Pytest: All tests passed"

# ── 4. Check for secrets accidentally staged ─────────────────
echo "  → Scanning for accidentally staged secrets..."
SECRETS=$(git diff --cached | grep -iE "(password\s*=\s*['\"][^'\"]+['\"]|secret\s*=\s*['\"][^'\"]+['\"]|api_key\s*=\s*['\"][^'\"]+['\"])" 2>/dev/null)
if [ -n "$SECRETS" ]; then
  echo ""
  echo "  ⚠️  WARNING: Possible secret in staged changes:"
  echo "$SECRETS"
  echo "  Review the above before committing."
  echo "  If this is a false positive, use: git commit --no-verify"
  exit 1
fi
echo "  ✅ Secrets scan: Clean"

# ── 5. Feature count guard ────────────────────────────────────
# Ensures NUMERICAL_FEATURES in config.py always has the expected count.
# Prevents silent feature additions/removals from breaking trained models.
echo "  → Checking NUMERICAL_FEATURES count..."
FEAT_COUNT=$(.venv/Scripts/python.exe -c "from ai.config import NUMERICAL_FEATURES; print(len(NUMERICAL_FEATURES))" 2>/dev/null)
if [ "$FEAT_COUNT" != "10" ]; then
  echo ""
  echo "  ❌ NUMERICAL_FEATURES COUNT MISMATCH"
  echo "  Expected 10, got: $FEAT_COUNT"
  echo "  If intentional, update this hook's expected count."
  exit 1
fi
echo "  ✅ Feature count: $FEAT_COUNT/10 OK"

echo ""
echo "✅ [pre-commit] All checks passed — proceeding with commit."
exit 0
